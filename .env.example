# Supabase Realtime is used only for presence and WebRTC signaling.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Generate with: openssl rand -base64 48
NETWORK_TOKEN_SECRET=replace-with-a-long-random-secret

# ICE configuration. STUN is enough for many same-LAN transfers.
STUN_URLS=stun:stun.l.google.com:19302

# Optional, strongly recommended for restrictive networks.
# Compatible with coturn TURN REST API (use-auth-secret/static-auth-secret).
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=3600
